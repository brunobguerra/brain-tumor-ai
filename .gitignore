# Data stays local
data/*
!data/**/
data/**/*
!data/**/.gitkeep

# Scratch space stays local
scratch/*
!scratch/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/

# Secrets
.env
.env.*
!.env.example

# Models and large artifacts
models/
*.pkl
*.joblib

# Machine-local agent settings
.claude/settings.local.json
